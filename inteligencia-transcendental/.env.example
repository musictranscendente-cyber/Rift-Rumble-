# Copie este arquivo para ".env" e preencha o que quiser ativar. Tudo é opcional.

# Endereço do servidor de IA (pasta backend/). Sem ele, a Síntese e o Oráculo usam os textos offline.
EXPO_PUBLIC_AI_URL=

# Chaves públicas do RevenueCat (app.revenuecat.com → Project → API keys). Sem elas, tudo fica liberado.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium

# Link curto que aparece nos cards de compartilhamento.
EXPO_PUBLIC_SHARE_URL=inteligenciatranscendental.app

# Link para o seu app de meditação (banner no perfil).
EXPO_PUBLIC_MEDITATION_APP_URL=
